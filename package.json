{
  "name": "hackathon-team-name-finder",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env start.mjs",
    "worker": "node --env-file-if-exists=.env worker.mjs",
    "api": "node --env-file-if-exists=.env --env-file-if-exists=.local/mps-runtime.env agent-api.mjs",
    "investigator:eve": "node --env-file-if-exists=.env --env-file-if-exists=.local/live.env investigator/eve-root.mjs",
    "investigator:api": "node --env-file-if-exists=.env --env-file-if-exists=.local/live.env investigator/api.mjs",
    "investigator:worker": "node --env-file-if-exists=.env --env-file-if-exists=.local/live.env investigator/worker.mjs",
    "main": "node --env-file-if-exists=.env --env-file-if-exists=.local/live.env --env-file-if-exists=.local/sniffer-secrets.env main/api.mjs",
    "stack": "docker compose --env-file .env --env-file .local/live.env --env-file .local/sniffer-secrets.env up -d --build",
    "test": "node --env-file-if-exists=.env --test *.test.mjs agents/*.test.mjs x402/*.test.mjs payout/*.test.mjs investigator/*.test.mjs main/*.test.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.71",
    "@evolution-sdk/evolution": "0.5.19",
    "@x402/cardano": "2.28.0",
    "@x402/core": "2.28.0",
    "@x402/fetch": "2.28.0",
    "ai": "7.0.127",
    "eve": "0.71.0",
    "zod": "4.6.5"
  }
}
