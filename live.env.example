# Non-secret live settings for Sniffer on Cardano Preprod.
# Copy to .local/live.env (git-ignored). The npm scripts and docker compose load it after .env.
# Secrets do NOT go here: see README "Configure" (.env, .local/sniffer-secrets.env, .local/payout.env).

# Backend
SNIFFER_BASE_URL=http://127.0.0.1:8080
EXPECTED_NETWORK=preprod
# Demo fixtures use made-up VAT IDs that the real EU VIES service rejects.
VIES_MODE=mock
# Fixed demo rate: 1190 EUR -> 1.19 tADA.
ADA_PER_EUR=0.001
PAYOUT_MAX_ADA_PER_INVOICE=10
PAYOUT_MAX_ADA_PER_DAY=50

# Customer intake (Main's x402 gate). Address of the `intake` wallet.
INTAKE_PAY_TO=addr_test1...
INTAKE_PRICE_LOVELACE=1000000

# Main pays the investigators from this x402 wallet (.local/x402/main-payer.json).
MAIN_PAYER_WALLET=main-payer
INVESTIGATOR_PRICE_LOVELACE=1000000
INVESTIGATION_TIMEOUT_MS=900000
# Optional: MAX_UNCONFIRMED_INTAKES=5, INTAKE_CONFIRM_TIMEOUT_MS=600000, MAIN_PORT=21951

# Investigator payees (addresses of the inv-invoice / inv-wallet / inv-supplier wallets) and APIs
INVESTIGATOR_INVOICE_PAY_TO=addr_test1...
INVESTIGATOR_WALLET_PAY_TO=addr_test1...
INVESTIGATOR_SUPPLIER_PAY_TO=addr_test1...
INVESTIGATOR_INVOICE_URL=http://127.0.0.1:21961
INVESTIGATOR_WALLET_URL=http://127.0.0.1:21962
INVESTIGATOR_SUPPLIER_URL=http://127.0.0.1:21963

# One Eve (Claude) runtime per role
EVE_URL_INVOICE=http://127.0.0.1:21971
EVE_URL_WALLET=http://127.0.0.1:21972
EVE_URL_SUPPLIER=http://127.0.0.1:21973
EVE_URL_MAIN=http://127.0.0.1:21974
MAIN_EVE_URL=http://127.0.0.1:21974

# Sokosumi (from your own provisioning; see README "Set up Sokosumi")
SOKOSUMI_ORGANIZATION_ID=
SOKOSUMI_ORGANIZATION_SLUG=
COWORKER_ID_INVOICE=
COWORKER_ID_WALLET=
COWORKER_ID_SUPPLIER=
